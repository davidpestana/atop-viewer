{
  "name": "atop-viewer",
  "version": "0.0.7-beta",
  "description": "Desktop GUI for Linux atop historical logs — atop log analyzer and visualizer (requires atop installed)",
  "keywords": [
    "atop",
    "atop-viewer",
    "atop-log-analyzer",
    "atop-visualizer",
    "atop-gui",
    "linux-monitoring",
    "electron",
    "devops",
    "sre",
    "sysadmin",
    "performance"
  ],
  "main": "out/main/index.js",
  "author": "davidpestana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidpestana/atop-viewer.git"
  },
  "homepage": "https://davidpestana.github.io/atop-viewer/",
  "bugs": {
    "url": "https://github.com/davidpestana/atop-viewer/issues"
  },
  "scripts": {
    "dev": "bash scripts/run.sh dev",
    "build": "electron-vite build",
    "preview": "bash scripts/run.sh preview",
    "start": "bash scripts/run.sh start",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux && bash scripts/patch-deb.sh",
    "validate:deb": "bash scripts/validate-deb.sh",
    "validate:packages": "bash scripts/validate-packages.sh",
    "dist:linux:check": "npm run dist:linux && npm run validate:packages",
    "clean:artifacts": "bash scripts/clean-artifacts.sh",
    "capture:demo": "npm run build && bash scripts/capture-demo.sh",
    "capture:demo:gif": "npm run build && bash scripts/capture-demo.sh --gif"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
