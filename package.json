{
  "name": "atop-viewer",
  "version": "0.0.4-beta",
  "description": "Graphical explorer for Linux atop performance logs",
  "main": "out/main/index.js",
  "author": "davidpestana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidpestana/atop-viewer.git"
  },
  "homepage": "https://davidpestana.github.io/atop-viewer/",
  "bugs": {
    "url": "https://github.com/davidpestana/atop-viewer/issues"
  },
  "scripts": {
    "dev": "bash scripts/run.sh dev",
    "build": "electron-vite build",
    "preview": "bash scripts/run.sh preview",
    "start": "bash scripts/run.sh start",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "validate:deb": "bash scripts/validate-deb.sh",
    "validate:packages": "bash scripts/validate-packages.sh",
    "dist:linux:check": "npm run dist:linux && npm run validate:packages"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
